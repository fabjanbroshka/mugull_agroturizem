---
import { testimonials } from '../data/content';
---

<section class="testimonials" aria-labelledby="testimonials-heading">
  <div class="container">
    <div class="testimonials-header" data-reveal>
      <span class="section-label">{testimonials.label}</span>
      <h2 class="section-title" id="testimonials-heading">{testimonials.headline}</h2>
    </div>

    <div class="carousel" id="testimonials-carousel" aria-live="polite" data-reveal>
      <ul class="carousel-track" id="testimonials-track">
        {testimonials.items.map((item, i) => (
          <li class="testimonial" role="group" aria-label={`Testimonial ${i + 1} of ${testimonials.items.length}`}>
            <svg class="quote-mark" aria-hidden="true" width="36" height="28" viewBox="0 0 36 28" fill="none">
              <path d="M0 28V17.6C0 12.48 1.28 8.4 3.84 5.36C6.4 2.24 10.24.32 15.36 0L16.96 3.04C13.28 3.84 10.64 5.44 9.04 7.84C7.52 10.16 6.88 12.88 7.12 16H14.4V28H0ZM21.6 28V17.6C21.6 12.48 22.88 8.4 25.44 5.36C28 2.24 31.84.32 36.96 0L38.56 3.04C34.88 3.84 32.24 5.44 30.64 7.84C29.12 10.16 28.48 12.88 28.72 16H36V28H21.6Z" fill="currentColor"/>
            </svg>
            <blockquote class="quote-text">
              <p>"{item.quote}"</p>
            </blockquote>
            <footer class="quote-footer">
              <strong class="quote-author">{item.author}</strong>
              <span class="quote-source">{item.source}</span>
            </footer>
          </li>
        ))}
      </ul>
    </div>

    <!-- Controls -->
    <div class="carousel-controls" data-reveal>
      <button class="arrow arrow-prev" id="t-prev" aria-label="Previous testimonial">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>

      <div class="dots" id="t-dots">
        {testimonials.items.map((_, i) => (
          <button class={`dot${i === 0 ? ' active' : ''}`} data-index={i} aria-label={`Go to testimonial ${i + 1}`}></button>
        ))}
      </div>

      <button class="arrow arrow-next" id="t-next" aria-label="Next testimonial">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .testimonials {
    background: var(--brand-mid);
    padding-block: var(--space-xl);
  }

  .testimonials-header {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  /* ── Carousel ── */
  .carousel {
    overflow: hidden;
    border-radius: var(--radius);
  }

  .carousel-track {
    display: flex;
    transition: transform 0.5s ease;
    will-change: transform;
  }

  .testimonial {
    min-width: 100%;
    background: var(--brand-cream);
    border-radius: var(--radius);
    padding: 48px 56px;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    box-sizing: border-box;
  }

  .quote-mark {
    color: var(--color-accent);
    opacity: 0.35;
    flex-shrink: 0;
  }

  .quote-text p {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.75;
    color: var(--color-text);
    font-style: italic;
  }

  .quote-footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .quote-author {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
  }

  .quote-source {
    font-size: 12px;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
  }

  /* ── Controls ── */
  .carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .arrow {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--brand-cream);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
    transition: background var(--transition), transform var(--transition);
    flex-shrink: 0;
  }

  .arrow:hover {
    background: var(--brand-light);
    transform: scale(1.08);
  }

  .dots {
    display: flex;
    gap: 8px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(44,44,42,0.25);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background var(--transition), transform var(--transition);
  }

  .dot.active {
    background: var(--color-text);
    transform: scale(1.3);
  }

  @media (max-width: 768px) {
    .testimonial { padding: 32px 24px; }
    .quote-text p { font-size: 16px; }
    .testimonials { padding-block: var(--space-lg); }
  }

  @media (max-width: 480px) {
    .testimonial { padding: 28px 20px; }
    .carousel-controls { gap: var(--space-sm); }
  }
</style>

<script>
  const track   = document.getElementById('testimonials-track') as HTMLElement;
  const dots    = Array.from(document.querySelectorAll<HTMLButtonElement>('#t-dots .dot'));
  const total   = dots.length;
  let current   = 0;
  let autoTimer: ReturnType<typeof setInterval>;

  function goTo(index: number) {
    current = (index + total) % total;
    track.style.transform = `translateX(-${current * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle('active', i === current));
  }

  function startAuto() {
    autoTimer = setInterval(() => goTo(current + 1), 5000);
  }
  function stopAuto() { clearInterval(autoTimer); }

  document.getElementById('t-prev')!.addEventListener('click', () => { stopAuto(); goTo(current - 1); startAuto(); });
  document.getElementById('t-next')!.addEventListener('click', () => { stopAuto(); goTo(current + 1); startAuto(); });
  dots.forEach((d, i) => d.addEventListener('click', () => { stopAuto(); goTo(i); startAuto(); }));

  // Touch / swipe support
  const carousel = document.getElementById('testimonials-carousel')!;
  let touchStartX = 0;
  carousel.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
  carousel.addEventListener('touchend', e => {
    const diff = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 40) { stopAuto(); goTo(diff > 0 ? current + 1 : current - 1); startAuto(); }
  });

  carousel.addEventListener('mouseenter', stopAuto);
  carousel.addEventListener('mouseleave', startAuto);

  startAuto();
</script>

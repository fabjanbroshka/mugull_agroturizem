---
import { cta } from '../data/content';
---

<section class="cta-band" id="book" aria-labelledby="cta-heading">
  <div class="container cta-inner" data-reveal>

    <div class="cta-text">
      <h2 class="cta-heading" id="cta-heading">{cta.headline}</h2>
      <p class="cta-sub">{cta.subtext}</p>
    </div>

    <div class="cta-actions">
      <a href={cta.reserve.href} class="btn btn-reserve" target="_blank" rel="noopener noreferrer">
        {cta.reserve.label}
      </a>
      <a href={cta.phone.href} class="btn btn-outline-dark">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.03 1.19 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.1 6.1l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
        </svg>
        {cta.phone.label}
      </a>
    </div>

  </div>
</section>

<style>
  .cta-band {
    background: var(--brand-dark);
    padding-block: 72px;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .cta-heading {
    font-family: var(--font-serif);
    font-size: clamp(26px, 3.5vw, 40px);
    font-weight: 500;
    color: #fff;
    margin-bottom: 8px;
  }

  .cta-sub {
    font-size: 15px;
    color: rgba(255,255,255,0.82);
    max-width: 420px;
  }

  .cta-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .btn-reserve {
    background: #fff;
    color: var(--brand-dark);
    border: 2px solid #fff;
    display: inline-flex;
    align-items: center;
    padding: 13px 28px;
    border-radius: var(--radius-pill);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.03em;
    transition: background var(--transition), border-color var(--transition);
  }

  .btn-reserve:hover {
    background: var(--brand-cream);
    border-color: var(--brand-cream);
  }

  .btn-outline-dark {
    background: transparent;
    color: #fff;
    border: 2px solid rgba(255,255,255,0.6);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 28px;
    border-radius: var(--radius-pill);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.03em;
    transition: background var(--transition), border-color var(--transition);
  }

  .btn-outline-dark:hover {
    background: rgba(255,255,255,0.12);
    border-color: #fff;
  }

  @media (max-width: 768px) {
    .cta-band { padding-block: var(--space-lg); }
    .cta-inner { flex-direction: column; align-items: flex-start; }
    .cta-actions { flex-direction: column; width: 100%; }
    .btn-reserve, .btn-outline-dark { justify-content: center; width: 100%; }
  }
</style>

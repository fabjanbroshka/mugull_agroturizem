---
import { hero } from '../data/content';
---

<!--
  Hero Carousel
  ─────────────────────────────────────────────────────────────
  Layout   : full-width, min-height 85vh desktop / 70vh mobile
  Images   : desktop ~2560×1440 (16:9), mobile ~1080×1350 (4:5)
             Art-directed via <picture> srcset.
  Carousel : cross-fade (opacity), Ken Burns zoom on active slide
  Autoplay : every 5 s, paused on hover / interaction
  Arrows   : desktop only (CSS media query)
  Dots     : always visible, bottom-centre
  Motion   : Ken Burns + autoplay disabled when prefers-reduced-motion
-->

<section class="hero" id="hero" aria-label="Hero carousel">
  <!-- ── Slides ──────────────────────────────────────────── -->
  <div class="slides" id="hero-slides">
    {hero.slides.map((slide, i) => (
      <div
        class={`slide${i === 0 ? ' active' : ''}`}
        aria-hidden={i !== 0 ? 'true' : 'false'}
        role="img"
        aria-label={slide.alt}
      >
        <!-- Art-directed image: mobile gets 4:5 crop, desktop 16:9 -->
        <picture>
          <source media="(max-width: 768px)" srcset={slide.srcMobile} />
          <img
            src={slide.srcDesktop}
            alt={slide.alt}
            class="slide-img"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding={i === 0 ? 'sync' : 'async'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
          />
        </picture>
        <!-- Warm-dark gradient overlay: lighter top → darker bottom -->
        <div class="slide-overlay" aria-hidden="true"></div>
      </div>
    ))}
  </div>

  <!-- ── Fixed text overlay (stays put as slides cross-fade) ── -->
  <div class="hero-content">
    {hero.eyebrow && <p class="eyebrow">{hero.eyebrow}</p>}
    <h1 class="headline">
      {hero.headline.split('\n').map((line, i) => (
        <span>{line}{i === 0 && <br/>}</span>
      ))}
    </h1>
    <p class="subtext">{hero.subtext}</p>
    <div class="hero-ctas">
      <a href={hero.ctaPrimary.href}   class="btn btn-primary">{hero.ctaPrimary.label}</a>
      <a href={hero.ctaSecondary.href} class="btn btn-outline-white">{hero.ctaSecondary.label}</a>
    </div>
  </div>

  <!-- ── Prev / Next arrows (desktop only via CSS) ─────────── -->
  <button class="arrow arrow-prev" id="hero-prev" aria-label="Previous slide">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="15 18 9 12 15 6"/>
    </svg>
  </button>
  <button class="arrow arrow-next" id="hero-next" aria-label="Next slide">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="9 18 15 12 9 6"/>
    </svg>
  </button>

  <!-- ── Dots ───────────────────────────────────────────────── -->
  <div class="dots" id="hero-dots" role="tablist" aria-label="Slide indicators">
    {hero.slides.map((_, i) => (
      <button
        class={`dot${i === 0 ? ' active' : ''}`}
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-label={`Go to slide ${i + 1}`}
        data-index={i}
      ></button>
    ))}
  </div>
</section>

<style>
  /* ── Hero shell ────────────────────────────────────────── */
  .hero {
    position: relative;
    width: 100%;
    min-height: 85vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Slides ────────────────────────────────────────────── */
  .slides {
    position: absolute;
    inset: 0;
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
    will-change: opacity;
  }

  .slide.active {
    opacity: 1;
  }

  /* Image fills the slide */
  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform-origin: center center;
    /* Ken Burns: zooms in while this slide is active */
    animation: kenburns 6s ease-out forwards paused;
  }

  .slide.active .slide-img {
    animation-play-state: running;
  }

  @keyframes kenburns {
    from { transform: scale(1.0); }
    to   { transform: scale(1.08); }
  }

  /* Warm-dark overlay: lighter at top, heavier at bottom */
  .slide-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(20, 30, 5, 0.2)  0%,
      rgba(20, 30, 5, 0.35) 40%,
      rgba(20, 30, 5, 0.65) 100%
    );
  }

  /* ── Fixed text overlay ────────────────────────────────── */
  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: var(--space-lg) var(--space-md);
    max-width: 760px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    animation: heroEnter 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
  }

  @keyframes heroEnter {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--brand-light);
  }

  .headline {
    font-family: var(--font-serif);
    font-size: clamp(44px, 7vw, 88px);
    font-weight: 500;
    line-height: 1.05;
    color: #fff;
    text-shadow: 0 2px 20px rgba(0,0,0,0.35);
  }

  .subtext {
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.8vw, 18px);
    font-weight: 300;
    color: rgba(255,255,255,0.88);
    letter-spacing: 0.03em;
    max-width: 480px;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
  }

  /* ── Arrows ────────────────────────────────────────────── */
  .arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255,255,255,0.12);
    border: 1.5px solid rgba(255,255,255,0.4);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition), border-color var(--transition);
  }

  .arrow:hover {
    background: rgba(255,255,255,0.22);
    border-color: rgba(255,255,255,0.8);
  }

  .arrow-prev { left: 28px;  }
  .arrow-next { right: 28px; }

  /* ── Dots ──────────────────────────────────────────────── */
  .dots {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255,255,255,0.4);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background var(--transition), transform var(--transition);
  }

  .dot.active {
    background: #fff;
    transform: scale(1.35);
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 768px) {
    .hero        { min-height: 75vh; }
    .arrow       { display: none; }
    .hero-ctas   { flex-direction: column; align-items: center; width: 100%; }
    .hero-ctas .btn { width: 100%; max-width: 280px; justify-content: center; }
    .hero-content { padding: var(--space-md) var(--space-sm); gap: 14px; }
  }

  @media (max-width: 480px) {
    .hero { min-height: 80vh; }
    .dots { bottom: 20px; }
  }

  /* ── Reduced motion ────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .slide-img {
      animation: none !important;
    }
    .slide {
      transition: opacity 0.3s ease;
    }
  }
</style>

<script>
  const carousel  = document.getElementById('hero-slides')  as HTMLElement;
  const dotsEl    = document.getElementById('hero-dots')     as HTMLElement;
  const prevBtn   = document.getElementById('hero-prev')     as HTMLButtonElement;
  const nextBtn   = document.getElementById('hero-next')     as HTMLButtonElement;

  const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.slide'));
  const dots   = Array.from(dotsEl.querySelectorAll<HTMLButtonElement>('.dot'));

  const DELAY = 5000;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let current = 0;
  let timer: ReturnType<typeof setInterval> | null = null;

  function resetKenBurns(slide: HTMLElement) {
    const img = slide.querySelector<HTMLElement>('.slide-img');
    if (!img || reduceMotion) return;
    // Restart CSS animation by briefly clearing animationName
    img.style.animationName = 'none';
    img.getBoundingClientRect(); // force reflow
    img.style.animationName = '';
  }

  function goTo(next: number) {
    const prev = current;
    current = ((next % slides.length) + slides.length) % slides.length;

    slides[prev].classList.remove('active');
    slides[prev].setAttribute('aria-hidden', 'true');
    dots[prev].classList.remove('active');
    dots[prev].setAttribute('aria-selected', 'false');

    resetKenBurns(slides[current]);

    slides[current].classList.add('active');
    slides[current].setAttribute('aria-hidden', 'false');
    dots[current].classList.add('active');
    dots[current].setAttribute('aria-selected', 'true');
  }

  function startAutoplay() {
    if (reduceMotion) return;
    timer = setInterval(() => goTo(current + 1), DELAY);
  }

  function stopAutoplay() {
    if (timer) { clearInterval(timer); timer = null; }
  }

  // Controls
  prevBtn.addEventListener('click', () => { stopAutoplay(); goTo(current - 1); startAutoplay(); });
  nextBtn.addEventListener('click', () => { stopAutoplay(); goTo(current + 1); startAutoplay(); });

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => { stopAutoplay(); goTo(i); startAutoplay(); });
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft')  { stopAutoplay(); goTo(current - 1); startAutoplay(); }
    if (e.key === 'ArrowRight') { stopAutoplay(); goTo(current + 1); startAutoplay(); }
  });

  // Pause on hover / focus
  const section = carousel.closest<HTMLElement>('.hero')!;
  section.addEventListener('mouseenter', stopAutoplay);
  section.addEventListener('mouseleave', startAutoplay);
  section.addEventListener('focusin',    stopAutoplay);
  section.addEventListener('focusout',   startAutoplay);

  // Boot
  startAutoplay();
</script>

---
import { offerings } from '../data/content';
---

<section class="offerings" id="offerings" aria-labelledby="offerings-heading">
  <div class="container">
    <div class="offerings-header" data-reveal>
      <span class="section-label">{offerings.label}</span>
      <h2 class="section-title" id="offerings-heading">{offerings.headline}</h2>
    </div>

    <ul class="offerings-grid" data-stagger>
      {offerings.items.map(item => (
        <li class="card">
          <div class="card-img">
            <img src={item.image.src} alt={item.image.alt} loading="lazy" decoding="async" />
          </div>
          <div class="card-body">
            <h3 class="card-title">{item.title}</h3>
            <p class="card-desc">{item.desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .offerings {
    background: var(--brand-light);
    padding-block: var(--space-xl);
  }

  .offerings-header {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .offerings-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }

  .card {
    background: var(--brand-cream);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    transition: box-shadow var(--transition), transform var(--transition);
  }

  .card:hover {
    box-shadow: 0 8px 32px rgba(0,0,0,0.1);
    transform: translateY(-3px);
  }

  .card-img {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .card:hover .card-img img {
    transform: scale(1.05);
  }

  .card-body {
    padding: 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text);
  }

  .card-desc {
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  @media (max-width: 1024px) {
    .offerings-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .offerings { padding-block: var(--space-lg); }
    .offerings-grid { grid-template-columns: 1fr; }
  }
</style>

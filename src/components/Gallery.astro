---
const images = [
  { src: '/image1D.jpg',  alt: 'Aerial view of the Mugull farm and surrounding highlands',      span: 'wide tall' },
  { src: '/image3D.jpg',  alt: 'Freshly harvested tomatoes, peppers and herbs in a basket'                       },
  { src: '/image4D.jpg',  alt: 'Slow-cooked lamb in a clay pot fresh from the wood-fired oven'                   },
  { src: '/Image5D.jpg',  alt: 'Guests dining on the open terrace at sunset'                                      },
  { src: '/Image6D.jpg',  alt: 'The farm vegetable garden in full bloom'                        , span: 'wide'   },
  { src: '/image2M.jpg',  alt: 'Homemade bread cooling on the kitchen counter'                                    },
  { src: '/Image7M.jpg',  alt: 'Wild mushrooms foraged from the mountain forest'                                  },
  { src: '/Image8M.jpg',  alt: 'A hand-poured glass of Albanian raki beside a charcuterie board'                 },
];
---

<section class="gallery" id="gallery" aria-labelledby="gallery-heading">
  <div class="container">
    <div class="gallery-header" data-reveal>
      <span class="section-label">A glimpse inside</span>
      <h2 class="section-title" id="gallery-heading">Gallery</h2>
    </div>
  </div>

  <div class="gallery-grid" role="list" data-stagger>
    {images.map(img => (
      <div class={`gallery-item${img.span ? ' ' + img.span : ''}`} role="listitem">
        <img
          src={img.src}
          alt={img.alt}
          loading="lazy"
          decoding="async"
        />
      </div>
    ))}
  </div>
</section>

<style>
  .gallery {
    background: var(--brand-light);
    padding-block: var(--space-xl);
  }

  .gallery-header {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 280px;
    gap: 10px;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: 10px;
  }

  .gallery-item {
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.06);
  }

  /* Span helpers */
  .gallery-item.wide { grid-column: span 2; }
  .gallery-item.tall { grid-row:    span 2; }

  @media (max-width: 900px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 220px;
    }
    .gallery-item.wide { grid-column: span 2; }
    .gallery-item.tall { grid-row: span 1; }
    .gallery { padding-block: var(--space-lg); }
  }

  @media (max-width: 480px) {
    .gallery-grid {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 160px;
      gap: 6px;
    }
    .gallery-item.wide { grid-column: span 2; }
    .gallery-item.tall { grid-row: span 1; }
  }
</style>

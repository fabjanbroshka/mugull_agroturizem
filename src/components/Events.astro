---
import { events, site } from '../data/content';
---

<section class="events" id="events" aria-labelledby="events-heading">
  <div class="container events-inner">

    <div class="events-header" data-reveal="left">
      <span class="section-label">{events.label}</span>
      <h2 class="section-title" id="events-heading">{events.headline}</h2>
      <p class="section-body">{events.subtext}</p>
      <a href={events.cta.href} class="btn btn-outline-green">{events.cta.label}</a>
    </div>

    <ul class="events-grid" data-stagger>
      {events.items.map(item => (
        <li class="event-card">
          <div class="event-img">
            <img src={item.image.src} alt={item.image.alt} loading="lazy" decoding="async" />
          </div>
          <div class="event-body">
            <h3 class="event-title">{item.title}</h3>
            <p class="event-desc">{item.desc}</p>
            <a href={site.reservationUrl} class="event-reserve" target="_blank" rel="noopener noreferrer">Reserve</a>
          </div>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .events {
    background: var(--brand-dark);
    padding-block: var(--space-xl);
  }

  .events-inner {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 72px;
    align-items: start;
  }

  .events-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    position: sticky;
    top: 100px;
  }

  .events-header .section-title { color: var(--brand-cream); }
  .events-header .section-body  { color: rgba(241,243,224,0.75); }
  .events-header .section-label { color: var(--brand-light); }

  .events-header .btn {
    align-self: flex-start;
    margin-top: var(--space-xs);
    border-color: var(--brand-light);
    color: var(--brand-cream);
  }
  .events-header .btn:hover {
    background: var(--brand-light);
    color: var(--brand-darker);
  }

  .events-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }

  .event-card {
    background: rgba(241, 243, 224, 0.08);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(241, 243, 224, 0.15);
    transition: box-shadow var(--transition), transform var(--transition);
  }

  .event-card:hover {
    box-shadow: 0 8px 28px rgba(0,0,0,0.18);
    transform: translateY(-3px);
  }

  .event-img {
    width: 100%;
    height: 190px;
    overflow: hidden;
  }

  .event-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .event-card:hover .event-img img {
    transform: scale(1.05);
  }

  .event-body {
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .event-title {
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 600;
    color: var(--brand-cream);
  }

  .event-desc {
    font-size: 13px;
    color: var(--brand-light);
    line-height: 1.7;
  }

  .event-reserve {
    display: inline-flex;
    align-items: center;
    margin-top: 10px;
    padding: 8px 20px;
    border-radius: var(--radius-pill);
    border: 1.5px solid rgba(241,243,224,0.45);
    font-size: 13px;
    font-weight: 500;
    color: var(--brand-cream);
    letter-spacing: 0.03em;
    transition: background var(--transition), border-color var(--transition);
    align-self: flex-start;
  }

  .event-reserve:hover {
    background: rgba(241,243,224,0.12);
    border-color: var(--brand-cream);
  }

  @media (max-width: 1024px) {
    .events-inner { gap: var(--space-lg); }
  }

  @media (max-width: 900px) {
    .events-inner {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
    .events-header { position: static; }
    .events { padding-block: var(--space-lg); }
    .events-header .btn { align-self: stretch; text-align: center; justify-content: center; }
  }

  @media (max-width: 480px) {
    .events-grid { grid-template-columns: 1fr; }
    .event-img { height: 200px; }
  }
</style>
